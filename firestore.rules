rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return isSignedIn() && userProfile().active == true;
    }

    function isAdmin() {
      return isActiveUser() && userProfile().role == 'admin';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /items/{itemId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin() && request.resource.data.businessId == userProfile().businessId;
      allow delete: if false;
    }

    match /expenses/{expenseId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.businessId == userProfile().businessId;
      allow delete: if false;
    }

    match /businesses/{businessId} {
      allow read: if isActiveUser() && businessId == userProfile().businessId;
      allow create, update: if isAdmin() && businessId == userProfile().businessId;
      allow delete: if false;
    }

    match /customers/{customerId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser() && request.resource.data.businessId == userProfile().businessId;
      allow delete: if false;
    }

    match /vehicles/{vehicleId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser() && request.resource.data.businessId == userProfile().businessId;
      allow delete: if false;
    }

    match /inventory/{inventoryId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser() && request.resource.data.businessId == userProfile().businessId;
      allow delete: if false;
    }

    match /counters/{businessId} {
      allow read, write: if isActiveUser() && businessId == userProfile().businessId;
    }

    match /invoices/{invoiceId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && request.resource.data.businessId == userProfile().businessId;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
